# Copy to .env and set a URL-safe password (for example: openssl rand -hex 32).
# Do not commit .env. Keep this password private and back it up with your database.
POSTGRES_DB=insighthub
POSTGRES_USER=insighthub
POSTGRES_PASSWORD=
COMPOSE_PROJECT_NAME=insighthub_release
WEB_PORT=8080
POSTGRES_HOST_PORT=15434
REDIS_HOST_PORT=16380

# Leave blank to use the persisted key generated in the app_data volume.
# If you set this, use the same value for backend and worker and back it up securely.
INSIGHTHUB_CREDENTIALS_MASTER_KEY=

# Optional external OpenAI-compatible embedding service (e.g. BGE-M3).
# For a host service use a Docker-reachable address such as http://host.docker.internal:8011/v1.
# The service must accept POST /embeddings. Leave all three blank to disable vector embeddings.
GENERIC_EMBEDDING_BASE_URL=
GENERIC_EMBEDDING_MODEL=BAAI/bge-m3
GENERIC_EMBEDDING_API_KEY=

# Paid image generation is off by default. This is InsightHub's local attempt cap,
# not a MiniMax subscription quota.
COVER_AUTO_ENABLED=false
COVER_AUTO_STARTUP_SCAN_ENABLED=false
COVER_MONTHLY_BUDGET=100
