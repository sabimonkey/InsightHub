# Local source install. Use a URL-safe random password (hex works without URL escaping).
POSTGRES_DB=insighthub
POSTGRES_USER=insighthub
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=15434
REDIS_HOST_PORT=16380
DATABASE_URL=postgresql+psycopg://insighthub:SET_THE_SAME_URL_SAFE_PASSWORD@127.0.0.1:15434/insighthub
REDIS_URL=redis://127.0.0.1:16380/0
INSIGHTHUB_API_HOST=127.0.0.1
INSIGHTHUB_API_PORT=8090
INSIGHTHUB_SYSTEM_SCOPE=USER
LOCAL_EMBEDDING_BASE_URL=
LOCAL_EMBEDDING_MODEL=
INSIGHTHUB_CREDENTIALS_MASTER_KEY=
COVER_AUTO_ENABLED=false
COVER_AUTO_STARTUP_SCAN_ENABLED=false
COVER_MONTHLY_BUDGET=100
